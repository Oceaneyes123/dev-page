<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Jezrel Dave</title>
	</head>
	<body>
		<main>
			<h1>Hi, I'm <mark>Jezrel Dave</mark></h1>
		</main>
	</body>
</html>

<style>
	@font-face {
		font-family: Roboto;
		src: url('/fonts/roboto-latin.woff2') format('woff2');
		font-weight: 400 800;
		font-display: swap;
	}

	body {
		margin: 0;
		color-scheme: dark;
		background: radial-gradient(ellipse at 50% 40%, #1b2325, #101315 70%);
		color: #b5c1c2;
		font-family: Roboto, Arial, sans-serif;
	}

	main {
		box-sizing: border-box;
		display: grid;
		place-items: center;
		min-height: 100dvh;
		padding: 1.5rem;
		text-align: center;
	}

	h1 {
		display: grid;
		justify-items: center;
		gap: clamp(0.5rem, 1.4vw, 1rem);
		margin: 0;
		font-size: clamp(1.125rem, 2vw, 1.5rem);
		font-weight: 400;
		line-height: 1.2;
	}

	mark {
		background: transparent;
		color: #c5f5df;
		font-size: clamp(2.25rem, 10vw, 8rem);
		font-weight: 800;
		letter-spacing: -0.065em;
		line-height: 1;
		text-wrap: balance;
	}
</style>
